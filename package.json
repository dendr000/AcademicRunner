{
  "name": "academicrunner",
  "productName": "AcademicRunner",
  "version": "1.17.3",
  "private": true,
  "description": "학원 과제 풀이 파일을 열어 고치고 실행·시험하는 개인용 Windows 앱",
  "author": "dendr000",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "node node_modules/electron/cli.js scripts/make-icon.cjs",
    "dist:win": "node scripts/package-win.js",
    "verify:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-exe.ps1",
    "vendor": "node scripts/vendor-monaco.js",
    "postinstall": "node scripts/vendor-monaco.js",
    "prestart": "node scripts/vendor-monaco.js",
    "predist:win": "node scripts/vendor-monaco.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.2",
    "monaco-editor": "^0.52.2"
  }
}
